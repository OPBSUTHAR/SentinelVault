{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci --no-audit --no-fund && npm run build",
  "functions": {
    "index.py": {
      "includeFiles": "{backend/**,frontend/dist/**}",
      "excludeFiles": "{backend/.venv/**,backend/**/__pycache__/**,backend/.env,backend/data/**,extension/**}"
    }
  }
}
