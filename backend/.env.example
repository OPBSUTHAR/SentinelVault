# SentinelVault backend configuration (copy to .env and adjust)
APP_NAME=SentinelVault
APP_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=8000

# Auth / sessions
JWT_SECRET=change-me-in-production
JWT_EXPIRY_MINUTES=60
SESSION_TTL_MINUTES=30

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5176,http://localhost:5173,http://localhost:3000

# Storage
DATABASE_PATH=data/sentinelvault.db

# Breach monitoring (Have I Been Pwned)
# The password range API (k-anonymity) needs no key.
# An API key is only required for live account/email breach lookups.
HIBP_API_KEY=
HIBP_PWNED_URL=https://api.pwnedpasswords.com
HIBP_API_URL=https://haveibeenpwned.com/api/v3

# Public URL of the frontend (used for share links)
PUBLIC_BASE_URL=http://localhost:5176
